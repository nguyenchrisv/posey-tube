[Unit]
Description=posey-tube GPIO HTTP API
Documentation=https://github.com/nguyenchrisv/posey-tube
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=posey-tube
Group=gpio
WorkingDirectory=/var/lib/posey-tube
# lgpio creates its notification FIFOs in LG_WD (default: the cwd); keep them off the read-only /opt
Environment=LG_WD=/run/posey-tube
StateDirectory=posey-tube
RuntimeDirectory=posey-tube
EnvironmentFile=-/etc/posey-tube/secrets.env
ExecStart=/opt/posey-tube/venv/bin/python -m posey_tube
ExecStopPost=/opt/posey-tube/venv/bin/python -m posey_tube --all-off
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=posey-tube

# Hardening
# GPIO goes through /dev/gpiochip* (group gpio). PrivateDevices=yes would hide those nodes
# (DeviceAllow= can't add them back), so use a closed device policy instead.
DevicePolicy=closed
DeviceAllow=char-gpiochip rw
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

# Resource limits
MemoryMax=100M
CPUQuota=50%

[Install]
WantedBy=multi-user.target