[Unit]
Description=posey-tube GPIO HTTP API
Documentation=https://github.com/nguyenchrisv/posey-tube
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=posey-tube
Group=gpio
WorkingDirectory=/opt/posey-tube
EnvironmentFile=-/etc/posey-tube/secrets.env
ExecStart=/opt/posey-tube/venv/bin/python -m posey_tube
ExecStopPost=/opt/posey-tube/venv/bin/python -m posey_tube --all-off
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=posey-tube

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DeviceAllow=/dev/gpiochip* rw
DeviceAllow=/dev/gpiomem rw
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_RAWIO
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_SYS_RAWIO

# Resource limits
MemoryLimit=100M
CPUQuota=50%

[Install]
WantedBy=multi-user.target